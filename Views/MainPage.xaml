<?xml version="1.0" encoding="UTF-8" ?>
<Page
    x:Class="LlamaCppDesk.Views.MainPage"
    xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
    xmlns:conv="using:LlamaCppDesk.Converters"
    xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
    xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
    xmlns:models="using:LlamaCppDesk.Models"
    x:Name="RootPage"
    mc:Ignorable="d">
    <Page.Resources>
        <conv:RoleToHorizontalAlignmentConverter x:Key="RoleToHorizontalAlignmentConverter" />
        <conv:RoleToBubbleBrushConverter x:Key="RoleToBubbleBrushConverter" />
    </Page.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="320" />
            <ColumnDefinition Width="*" />
        </Grid.ColumnDefinitions>

        <Border Grid.Column="0" Padding="16" Background="{ThemeResource LayerFillColorDefaultBrush}">
            <ScrollViewer VerticalScrollBarVisibility="Auto">
                <StackPanel Spacing="4">
                    <TextBlock Text="Llama.cpp Desk" FontSize="22" FontWeight="SemiBold" />
                    <TextBlock Text="Local GUI wrapper inspired by Ollama" Opacity="0.7" Margin="0,0,0,8" />

                    <TextBlock Style="{StaticResource SidebarSectionTitle}" Text="Server" />
                    <TextBlock Text="llama-server.exe path" Opacity="0.75" />
                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ServerPathBox" Style="{StaticResource FormTextBox}" Margin="0" PlaceholderText="C:\\tools\\llama\\llama-server.exe" />
                        <Button Grid.Column="1" Content="Browse" Click="OnBrowseServerClicked" />
                    </Grid>

                    <TextBlock Text="Recent servers" Opacity="0.75" />
                    <ComboBox x:Name="ServerHistoryBox" PlaceholderText="No server history yet" ItemsSource="{x:Bind ServerHistory, Mode=OneWay}" Margin="0,0,0,8" SelectionChanged="ServerHistoryBox_SelectionChanged" />

                    <TextBlock Text="Model (.gguf) path" Opacity="0.75" />
                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="ModelPathBox" Style="{StaticResource FormTextBox}" Margin="0" PlaceholderText="C:\\models\\my-model.gguf" />
                        <Button Grid.Column="1" Content="Browse" Click="OnBrowseModelClicked" />
                    </Grid>

                    <TextBlock Text="Model presets/history" Opacity="0.75" />
                    <ComboBox x:Name="ModelHistoryBox" PlaceholderText="No model history yet" ItemsSource="{x:Bind ModelHistory, Mode=OneWay}" Margin="0,0,0,8" SelectionChanged="ModelHistoryBox_SelectionChanged" />

                    <TextBlock Style="{StaticResource SidebarSectionTitle}" Text="Presets" />
                    <TextBlock Text="Preset name" Opacity="0.75" />
                    <TextBox x:Name="PresetNameBox" Style="{StaticResource FormTextBox}" PlaceholderText="Balanced" />
                    <TextBlock Text="Saved presets" Opacity="0.75" />
                    <ComboBox x:Name="PresetBox" PlaceholderText="No presets yet" ItemsSource="{x:Bind PresetNames, Mode=OneWay}" Margin="0,0,0,8" SelectionChanged="PresetBox_SelectionChanged" />
                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="Save Preset" Click="OnSavePresetClicked" />
                        <Button Content="Apply" Click="OnApplyPresetClicked" />
                        <Button Content="Delete" Click="OnDeletePresetClicked" />
                    </StackPanel>

                    <TextBlock Style="{StaticResource SidebarSectionTitle}" Text="Model Downloader" />
                    <TextBlock Text="Model URL (.gguf direct link)" Opacity="0.75" />
                    <TextBox x:Name="DownloadUrlBox" Style="{StaticResource FormTextBox}" PlaceholderText="https://.../model.gguf" />
                    <TextBlock Text="Recent URLs" Opacity="0.75" />
                    <ComboBox x:Name="DownloadUrlHistoryBox" PlaceholderText="No download history yet" ItemsSource="{x:Bind DownloadUrlHistory, Mode=OneWay}" Margin="0,0,0,8" SelectionChanged="DownloadUrlHistoryBox_SelectionChanged" />

                    <TextBlock Text="Download folder" Opacity="0.75" />
                    <Grid ColumnSpacing="8" Margin="0,0,0,8">
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="*" />
                            <ColumnDefinition Width="Auto" />
                        </Grid.ColumnDefinitions>
                        <TextBox x:Name="DownloadFolderBox" Style="{StaticResource FormTextBox}" Margin="0" PlaceholderText="C:\Users\Ivan\Downloads\LLMModels" />
                        <Button Grid.Column="1" Content="Browse" Click="OnBrowseDownloadFolderClicked" />
                    </Grid>

                    <TextBlock Text="Save as file name (optional)" Opacity="0.75" />
                    <TextBox x:Name="DownloadFileNameBox" Style="{StaticResource FormTextBox}" PlaceholderText="model.gguf" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,0,0,8">
                        <Button Content="Download" Click="OnDownloadModelClicked" />
                        <Button Content="Cancel" Click="OnCancelDownloadClicked" />
                    </StackPanel>

                    <ProgressBar x:Name="DownloadProgressBar" Minimum="0" Maximum="100" Value="0" Height="10" Margin="0,0,0,4" />
                    <TextBlock Text="{x:Bind DownloadProgressText, Mode=OneWay}" Opacity="0.75" Margin="0,0,0,8" />

                    <TextBlock Text="Host" Opacity="0.75" />
                    <TextBox x:Name="HostBox" Style="{StaticResource FormTextBox}" PlaceholderText="127.0.0.1" />

                    <TextBlock Text="Port" Opacity="0.75" />
                    <TextBox x:Name="PortBox" Style="{StaticResource FormTextBox}" PlaceholderText="8080" />

                    <TextBlock Style="{StaticResource SidebarSectionTitle}" Text="Runtime" />
                    <TextBlock Text="Context size" Opacity="0.75" />
                    <TextBox x:Name="ContextBox" Style="{StaticResource FormTextBox}" PlaceholderText="4096" />

                    <TextBlock Text="Threads" Opacity="0.75" />
                    <TextBox x:Name="ThreadsBox" Style="{StaticResource FormTextBox}" PlaceholderText="4" />

                    <TextBlock Text="GPU layers (0 = CPU only)" Opacity="0.75" />
                    <TextBox x:Name="GpuLayersBox" Style="{StaticResource FormTextBox}" PlaceholderText="0" />

                    <TextBlock Style="{StaticResource SidebarSectionTitle}" Text="Generation" />
                    <TextBlock Text="Temperature" Opacity="0.75" />
                    <TextBox x:Name="TemperatureBox" Style="{StaticResource FormTextBox}" PlaceholderText="0.7" />

                    <TextBlock Text="Max tokens" Opacity="0.75" />
                    <TextBox x:Name="MaxTokensBox" Style="{StaticResource FormTextBox}" PlaceholderText="512" />

                    <StackPanel Orientation="Horizontal" Spacing="8" Margin="0,10,0,0">
                        <Button Content="Save" Click="OnSaveSettingsClicked" Style="{StaticResource PrimaryAction}" />
                        <Button Content="Start" Click="OnStartClicked" />
                        <Button Content="Stop" Click="OnStopClicked" />
                    </StackPanel>

                    <TextBlock Text="{x:Bind ServerStatusText, Mode=OneWay}" Margin="0,10,0,0" TextWrapping="Wrap" />
                </StackPanel>
            </ScrollViewer>
        </Border>

        <Grid Grid.Column="1" Padding="14">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
                <RowDefinition Height="Auto" />
            </Grid.RowDefinitions>

            <Border Padding="12" CornerRadius="10" Background="{ThemeResource LayerFillColorAltBrush}">
                <StackPanel Orientation="Horizontal" Spacing="10" VerticalAlignment="Center">
                    <Ellipse Width="10" Height="10" Fill="{x:Bind StatusDotBrush, Mode=OneWay}" />
                    <TextBlock Text="{x:Bind HeaderStatusText, Mode=OneWay}" FontWeight="SemiBold" />
                </StackPanel>
            </Border>

            <ListView
                x:Name="ChatList"
                Grid.Row="1"
                Margin="0,12,0,12"
                ItemsSource="{x:Bind Messages, Mode=OneWay}"
                IsItemClickEnabled="False"
                SelectionMode="None">
                <ListView.ItemTemplate>
                    <DataTemplate x:DataType="models:ChatMessage">
                        <StackPanel
                            HorizontalAlignment="{Binding Role, Converter={StaticResource RoleToHorizontalAlignmentConverter}}"
                            MaxWidth="780"
                            Margin="0,4">
                            <Border
                                Background="{Binding Role, Converter={StaticResource RoleToBubbleBrushConverter}}"
                                CornerRadius="14"
                                Padding="12,9">
                                <TextBlock Text="{x:Bind Content}" TextWrapping="Wrap" Foreground="White" />
                            </Border>
                        </StackPanel>
                    </DataTemplate>
                </ListView.ItemTemplate>
            </ListView>

            <Border Grid.Row="2" Background="{ThemeResource LayerFillColorAltBrush}" CornerRadius="12" Padding="10">
                <Grid ColumnSpacing="8">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <TextBox
                        x:Name="PromptBox"
                        AcceptsReturn="True"
                        MinHeight="54"
                        MaxHeight="130"
                        PlaceholderText="Type a message..."
                        TextWrapping="Wrap"
                        KeyDown="PromptBox_KeyDown" />
                    <Button Grid.Column="1" Content="Send" Style="{StaticResource PrimaryAction}" Click="OnSendClicked" />
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Page>
