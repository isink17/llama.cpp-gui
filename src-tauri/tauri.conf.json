{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "LlamaCppDesk",
  "version": "0.1.0",
  "identifier": "com.llamacppdesk.app",
  "build": {
    "beforeDevCommand": "npm --prefix ../ui run dev",
    "beforeBuildCommand": "npm --prefix ../ui run build",
    "devUrl": "http://localhost:1420",
    "frontendDist": "../ui/dist"
  },
  "app": {
    "security": {
      "csp": "default-src 'self'; script-src 'self'; style-src 'self' 'unsafe-inline'; connect-src 'self' http://127.0.0.1:* http://localhost:* https://huggingface.co https://registry.ollama.ai; img-src 'self'; font-src 'self'"
    },
    "windows": [
      {
        "label": "main",
        "title": "LlamaCppDesk",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 600,
        "resizable": true
      }
    ]
  },
  "bundle": {
    "icon": [
      "icons/icon.ico",
      "icons/icon.png"
    ],
    "shortDescription": "Desktop client for llama.cpp inference",
    "longDescription": "LlamaCppDesk is a cross-platform desktop application for managing and chatting with local llama.cpp models.",
    "copyright": "Copyright (c) 2025 LlamaCppDesk contributors",
    "license": "MIT",
    "windows": {
      "wix": {
        "language": "en-US"
      }
    }
  }
}
